{
  "manifest_version": 3,
  "name": "Job Finder Assistant",
  "version": "1.0.0",
  "description": "Extracts visible text from the current page.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage", 
    "sidePanel"
  ],

  "action": {
        "default_title": "Open Job Assistant"
    },
      "host_permissions": [
          "https://dzobs.com/posao/*",
          "https://www.linkedin.com/jobs/*",
          "https://helloworld.rs/posao/*"
],

    "side_panel": {
        "default_path": "popup.html"
    },

    "background": {
        "service_worker": "background.js"
    }
}
